# ---- Chorus environment ----
# Copy to .env.local (web) / .env (worker). Never commit real values.

# Postgres connection (Supabase: use the "connection pooling"/direct URL from the dashboard).
DATABASE_URL=postgresql://chorus:chorus@localhost:5432/chorus

# Redis for BullMQ job queues.
REDIS_URL=redis://localhost:6379

# Secret used to sign local storage URLs and dev-auth cookies. Generate with `openssl rand -hex 32`.
CHORUS_SECRET=change-me

# Public base URL of the web app (used to build shareable casting / listen links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (auth + storage). Leave blank for local dev mode. ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chorus

# When Supabase is not configured, CHORUS_DEV_AUTH=1 enables a cookie-based dev login
# (never honoured when NODE_ENV=production).
CHORUS_DEV_AUTH=1

# Storage provider: "supabase" or "local". Defaults to supabase when SUPABASE_* is set, else local.
CHORUS_STORAGE=local
CHORUS_LOCAL_STORAGE_DIR=./.data/storage

# ---- Worker-only secrets (the web app never calls these for pipeline work) ----
ANTHROPIC_API_KEY=
# Strong model for character extraction / reconciliation; fast model for high-volume attribution.
CHORUS_LLM_MODEL_STRONG=claude-opus-5
CHORUS_LLM_MODEL_FAST=claude-sonnet-5
# Set to "fake" to run the pipeline without any LLM calls (deterministic heuristics only).
CHORUS_LLM_PROVIDER=anthropic

# TTS provider: "elevenlabs" or "mock" (mock renders tones/silence, useful for local dev + tests).
CHORUS_TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Path to ffmpeg/ffprobe binaries (defaults to whatever is on PATH).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Feature flags
CHORUS_ENABLE_VOICE_CLONING=0
